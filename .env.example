MEMORY_LISTEN=127.0.0.1:19442
MEMORY_PUBLIC_URL=http://127.0.0.1:19442
MEMORY_DATABASE_URL=postgres://memory:change-me@127.0.0.1:5432/memory?sslmode=disable
MEMORY_UI_DIR=web/dist
# 32 random bytes, encoded as 64 hex characters. Stable across replicas/restarts.
MEMORY_ENCRYPTION_KEY=
MEMORY_SSO_ISSUER=https://sso.lexmount.com/oidc
MEMORY_SSO_CLIENT_ID=
MEMORY_SSO_CLIENT_SECRET=
# Register exactly: <MEMORY_PUBLIC_URL>/auth/callback
# Enable either or both providers by setting URL and API_KEY together.
MEMORY_HINDSIGHT_URL=
MEMORY_HINDSIGHT_API_KEY=
# MEMORY_HINDSIGHT_NAMESPACE_PREFIX=memory
MEMORY_HINDSIGHT_STORAGE_TENANT=
MEMORY_OPENVIKING_URL=
MEMORY_OPENVIKING_API_KEY=
# MEMORY_OPENVIKING_NAMESPACE_PREFIX=memory
# Shared SSRF transport setting, required only for trusted private Provider IPs.
# Loopback and metadata endpoints remain blocked. Use the Provider's LAN address.
MEMORY_ALLOW_PRIVATE_IP=false
